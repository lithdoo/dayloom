# Copy to .env for run-tui.* (do not commit .env)
DEEPSEEK_API_KEY=sk-...

# Optional core2/tui2 provider overrides.
# DAYLOOM_LLM_MODEL=deepseek-chat
# DAYLOOM_LLM_BASE_URL=https://api.deepseek.com/v1
# DAYLOOM_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

# Optional: use a custom promptpile-mcp executable.
# PROMPTPILE_MCP_BIN=/absolute/path/to/promptpile-mcp

# Optional: connect to an existing promptpile-mcp gateway.
# PROMPTPILE_MCP_BASE_URL=http://127.0.0.1:8765
# PROMPTPILE_MCP_TOKEN=...
