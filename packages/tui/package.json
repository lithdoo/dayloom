{
  "name": "@dayloom/tui",
  "version": "1.0.0-beta.1",
  "description": "Fullscreen TUI for the Dayloom runtime.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dayloom-tui": "./dist/main.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "guard": "node scripts/check-architecture.mjs",
    "test": "npm run build && npm run guard && node scripts/run-tests.mjs && npm run test:pack",
    "test:pack": "node scripts/test-pack.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "package.json"
  ],
  "dependencies": {
    "@bindtty/interaction": "^0.1.0-beta.6",
    "@bindtty/terminal": "^0.1.0-beta.6",
    "@bindtty/vnode": "^0.1.0-beta.6",
    "@bindtty/widgets": "^0.1.0-beta.6",
    "@dayloom/core": "1.0.0-beta.1",
    "bindtty": "^0.1.0-beta.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "engines": { "node": ">=20" }
}
