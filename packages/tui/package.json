{
  "name": "@dayloom/tui",
  "version": "0.0.0",
  "description": "Fullscreen TUI for the Dayloom runtime.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dayloom-tui": "./dist/main.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "package.json"
  ],
  "dependencies": {
    "@bindtty/interaction": "^0.1.0-beta.4",
    "@bindtty/terminal": "file:../../../bindtty/packages/terminal",
    "@bindtty/vnode": "^0.1.0-beta.4",
    "@bindtty/widgets": "^0.1.0-beta.4",
    "@dayloom/core": "*",
    "bindtty": "file:../../../bindtty/packages/bindtty"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
