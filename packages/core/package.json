{
  "name": "@dayloom/core",
  "version": "1.0.0-beta.1",
  "description": "Archive V2 Dayloom product lifecycle runtime.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prompts": {
      "types": "./dist/session/prompts/index.d.ts",
      "require": "./dist/session/prompts/index.js",
      "default": "./dist/session/prompts/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "guard": "node scripts/check-architecture.mjs",
    "spike:file-runtime": "node scripts/spike-session-file-runtime.mjs",
    "test": "npm run build && npm run guard && node scripts/run-tests.mjs && npm run test:pack",
    "test:pack": "node scripts/test-pack.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dayloom/archive-protocol": "1.0.0-beta.1",
    "@iarna/toml": "^2.2.5",
    "@rustmcp/rust-mcp-filesystem": "0.4.3",
    "ajv": "^8.17.1",
    "promptpile": "0.1.0-beta.2",
    "promptpile-compress": "0.1.0-beta.2",
    "promptpile-mcp": "0.1.0-beta.3",
    "promptpile-protocol": "0.1.0-beta.2",
    "promptpile-react": "0.1.0-beta.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "~5.9.3"
  }
}
