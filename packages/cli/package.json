{
  "name": "@dayloom/cli",
  "version": "1.0.0-beta.1",
  "description": "Draft-driven command-line boundary for Dayloom worlds.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dayloom": "./dist/main.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/cli.test.js test/mutation.test.js test/settle.test.js test/draft.test.js test/draft-mutation.test.js test/ai.test.js",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "dependencies": {
    "@dayloom/archive-protocol": "1.0.0-beta.1",
    "@iarna/toml": "^2.2.5",
    "@rustmcp/rust-mcp-filesystem": "0.4.3",
    "ajv": "^8.17.1",
    "promptpile": "0.1.0-beta.2",
    "promptpile-mcp": "0.1.0-beta.3",
    "promptpile-protocol": "0.1.0-beta.2",
    "promptpile-react": "0.1.0-beta.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
